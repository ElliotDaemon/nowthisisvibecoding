  "previewHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Flux - Ship faster with AI</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{font-family:'Inter',sans-serif;background:#09090b;color:#fafafa;overflow-x:hidden}\n\n/* Nav */\nnav{position:fixed;top:0;left:0;right:0;z-index:50;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;background:rgba(9,9,11,.8);backdrop-filter:blur(12px);border-bottom:1px solid #1a1a2e}\n.logo{font-size:20px;font-weight:800;letter-spacing:-1px;background:linear-gradient(135deg,#8b5cf6,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.nav-links{display:flex;gap:24px;font-size:14px;color:#a1a1aa}\n.nav-links a{color:inherit;text-decoration:none;transition:color .2s}\n.nav-links a:hover{color:#fff}\n.nav-cta{padding:8px 20px;border-radius:8px;background:#8b5cf6;color:#fff;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .2s}\n.nav-cta:hover{background:#7c3aed;transform:translateY(-1px)}\n\n/* Hero */\n.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden}\n.hero::before{content:'';position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(139,92,246,.15),transparent 70%);top:-200px;left:50%;transform:translateX(-50%);pointer-events:none}\n.hero-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 16px;border-radius:100px;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.2);font-size:12px;font-weight:500;color:#a78bfa;margin-bottom:32px;animation:fadeUp .6s ease}\n.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:#22c55e;animation:pulse 2s ease-in-out infinite}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}\n.hero h1{font-size:clamp(36px,8vw,72px);font-weight:900;letter-spacing:-2px;line-height:1.05;margin-bottom:24px;animation:fadeUp .6s ease .1s both}\n.hero h1 .gradient{background:linear-gradient(135deg,#8b5cf6,#ec4899,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.hero p{font-size:clamp(16px,2.5vw,20px);color:#a1a1aa;max-width:560px;line-height:1.6;margin-bottom:40px;animation:fadeUp .6s ease .2s both}\n.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;animation:fadeUp .6s ease .3s both}\n.btn-primary{padding:14px 32px;border-radius:12px;background:#8b5cf6;color:#fff;font-size:16px;font-weight:600;border:none;cursor:pointer;transition:all .25s;box-shadow:0 0 30px rgba(139,92,246,.3)}\n.btn-primary:hover{background:#7c3aed;transform:translateY(-2px);box-shadow:0 0 50px rgba(139,92,246,.4)}\n.btn-secondary{padding:14px 32px;border-radius:12px;background:transparent;color:#fff;font-size:16px;font-weight:600;border:1px solid #27272a;cursor:pointer;transition:all .25s}\n.btn-secondary:hover{border-color:#8b5cf6;background:rgba(139,92,246,.05)}\n@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}\n\n/* Stats */\n.stats{display:flex;gap:48px;justify-content:center;padding:60px 24px;border-top:1px solid #1a1a2e;border-bottom:1px solid #1a1a2e;margin:0 24px}\n.stat{text-align:center}\n.stat-num{font-size:36px;font-weight:800;letter-spacing:-1px;background:linear-gradient(135deg,#8b5cf6,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.stat-label{font-size:13px;color:#71717a;margin-top:4px}\n\n/* Features */\n.features{padding:100px 24px;max-width:960px;margin:0 auto}\n.features-header{text-align:center;margin-bottom:64px}\n.features-header h2{font-size:clamp(28px,5vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px}\n.features-header p{font-size:16px;color:#71717a;max-width:480px;margin:0 auto;line-height:1.6}\n.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}\n.feature-card{padding:28px;border-radius:16px;background:#111118;border:1px solid #1a1a2e;transition:all .3s}\n.feature-card:hover{border-color:#8b5cf6;transform:translateY(-4px);box-shadow:0 8px 30px rgba(139,92,246,.1)}\n.feature-icon{width:48px;height:48px;border-radius:12px;background:rgba(139,92,246,.1);display:flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:16px}\n.feature-card h3{font-size:17px;font-weight:700;margin-bottom:8px}\n.feature-card p{font-size:14px;color:#71717a;line-height:1.6}\n\n/* CTA */\n.cta{text-align:center;padding:100px 24px;position:relative}\n.cta::before{content:'';position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(236,72,153,.08),transparent 70%);bottom:-200px;left:50%;transform:translateX(-50%);pointer-events:none}\n.cta h2{font-size:clamp(28px,5vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px}\n.cta p{font-size:16px;color:#71717a;max-width:440px;margin:0 auto 32px;line-height:1.6}\n\n/* Footer */\nfooter{padding:40px 24px;border-top:1px solid #1a1a2e;text-align:center;font-size:13px;color:#52525b}\n\n@media(max-width:600px){\n  .nav-links{display:none}\n  .stats{gap:24px;flex-wrap:wrap}\n  .hero{padding:100px 20px 60px}\n}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"logo\">flux</div>\n  <div class=\"nav-links\">\n    <a href=\"#features\">Features</a>\n    <a href=\"#pricing\">Pricing</a>\n    <a href=\"#about\">About</a>\n  </div>\n  <button class=\"nav-cta\">Get Started</button>\n</nav>\n\n<section class=\"hero\">\n  <div class=\"hero-badge\"><span class=\"dot\"></span> Now in public beta</div>\n  <h1>Ship products<br><span class=\"gradient\">10x faster</span></h1>\n  <p>Flux is the AI-powered development platform that turns your ideas into production-ready code in minutes, not months.</p>\n  <div class=\"hero-buttons\">\n    <button class=\"btn-primary\">Start Building Free</button>\n    <button class=\"btn-secondary\">Watch Demo</button>\n  </div>\n</section>\n\n<div class=\"stats\">\n  <div class=\"stat\"><div class=\"stat-num\">50K+</div><div class=\"stat-label\">Developers</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">2M+</div><div class=\"stat-label\">Projects Built</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">99.9%</div><div class=\"stat-label\">Uptime</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">4.9</div><div class=\"stat-label\">Rating</div></div>\n</div>\n\n<section class=\"features\" id=\"features\">\n  <div class=\"features-header\">\n    <h2>Everything you need</h2>\n    <p>From idea to deployment, Flux handles the entire development lifecycle.</p>\n  </div>\n  <div class=\"features-grid\">\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x26A1;</div>\n      <h3>AI Code Generation</h3>\n      <p>Describe what you want in plain English. Our AI writes clean, production-ready code instantly.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x1F504;</div>\n      <h3>Live Preview</h3>\n      <p>See changes in real-time as they happen. No build steps, no waiting, no refreshing.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x1F680;</div>\n      <h3>One-Click Deploy</h3>\n      <p>Deploy to production with a single click. SSL, CDN, and scaling handled automatically.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x1F46B;</div>\n      <h3>Team Collaboration</h3>\n      <p>Work together in real-time. Share projects, review code, and ship as a team.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x1F512;</div>\n      <h3>Enterprise Security</h3>\n      <p>SOC2 compliant, end-to-end encryption, and fine-grained access controls.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">&#x1F4CA;</div>\n      <h3>Built-in Analytics</h3>\n      <p>Track performance, monitor errors, and understand your users out of the box.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta\">\n  <h2>Ready to ship faster?</h2>\n  <p>Join thousands of developers building the future with Flux. Free to start, no credit card required.</p>\n  <button class=\"btn-primary\">Get Started for Free</button>\n</section>\n\n<footer>\n  &copy; 2026 Flux. Built with vibecoding.\n</footer>\n\n</body>\n</html>\n",
