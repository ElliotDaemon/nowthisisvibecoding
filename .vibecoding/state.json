    "preview/index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>10/10 Cannabis — Premium Cannabis</title>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap');\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{font-family:'Inter',sans-serif;background:#0a0a0a;color:#f5f0eb;overflow-x:hidden}\n\n/* Nav */\nnav{position:fixed;top:0;left:0;right:0;z-index:50;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;background:rgba(10,10,10,.85);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.06)}\n.nav-logo{font-family:'Playfair Display',serif;font-size:22px;font-weight:900;letter-spacing:-1px}\n.nav-logo span{color:#8B6914}\n.nav-links{display:flex;gap:28px;font-size:13px;font-weight:500;letter-spacing:.5px;text-transform:uppercase;color:rgba(245,240,235,.5)}\n.nav-links a{color:inherit;text-decoration:none;transition:color .3s}\n.nav-links a:hover{color:#C9A94E}\n.nav-cta{padding:10px 24px;border-radius:100px;background:linear-gradient(135deg,#8B6914,#C9A94E);color:#0a0a0a;font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;border:none;cursor:pointer;transition:all .3s}\n.nav-cta:hover{transform:translateY(-1px);box-shadow:0 8px 30px rgba(201,169,78,.3)}\n\n/* Hero */\n.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden}\n.hero::before{content:'';position:absolute;width:700px;height:700px;background:radial-gradient(circle,rgba(139,105,20,.12),transparent 65%);top:-250px;left:50%;transform:translateX(-50%);pointer-events:none}\n.hero::after{content:'';position:absolute;width:400px;height:400px;background:radial-gradient(circle,rgba(201,169,78,.06),transparent 70%);bottom:-100px;right:-100px;pointer-events:none}\n.hero-tag{display:inline-flex;align-items:center;gap:8px;padding:8px 20px;border-radius:100px;background:rgba(201,169,78,.08);border:1px solid rgba(201,169,78,.15);font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#C9A94E;margin-bottom:40px;animation:fadeUp .8s ease}\n.hero-tag .leaf{font-size:14px}\n.hero h1{font-family:'Playfair Display',serif;font-size:clamp(42px,10vw,88px);font-weight:900;letter-spacing:-2px;line-height:1;margin-bottom:8px;animation:fadeUp .8s ease .1s both}\n.hero .brand-accent{background:linear-gradient(135deg,#8B6914,#C9A94E,#E8D48B,#C9A94E);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200% auto;animation:fadeUp .8s ease .1s both,goldShimmer 4s ease-in-out infinite}\n@keyframes goldShimmer{0%,100%{background-position:0% center}50%{background-position:200% center}}\n.hero-sub{font-size:clamp(15px,2.5vw,20px);color:rgba(245,240,235,.45);max-width:500px;line-height:1.7;margin:28px auto 44px;font-weight:300;animation:fadeUp .8s ease .2s both}\n.hero-buttons{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;animation:fadeUp .8s ease .3s both}\n.btn-gold{padding:16px 40px;border-radius:100px;background:linear-gradient(135deg,#8B6914,#C9A94E);color:#0a0a0a;font-size:14px;font-weight:700;letter-spacing:.5px;border:none;cursor:pointer;transition:all .3s;box-shadow:0 4px 25px rgba(139,105,20,.25)}\n.btn-gold:hover{transform:translateY(-2px);box-shadow:0 8px 40px rgba(139,105,20,.4)}\n.btn-outline{padding:16px 40px;border-radius:100px;background:transparent;color:#f5f0eb;font-size:14px;font-weight:500;border:1px solid rgba(255,255,255,.12);cursor:pointer;transition:all .3s}\n.btn-outline:hover{border-color:#C9A94E;color:#C9A94E;background:rgba(201,169,78,.04)}\n@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}\n\n/* Divider */\n.gold-line{width:60px;height:1px;background:linear-gradient(90deg,transparent,#C9A94E,transparent);margin:0 auto}\n\n/* Featured Products */\n.products{padding:100px 24px;max-width:1000px;margin:0 auto}\n.section-tag{display:block;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#C9A94E;text-align:center;margin-bottom:16px}\n.section-title{font-family:'Playfair Display',serif;font-size:clamp(28px,5vw,48px);font-weight:900;letter-spacing:-1px;text-align:center;margin-bottom:16px}\n.section-sub{font-size:15px;color:rgba(245,240,235,.4);text-align:center;max-width:460px;margin:0 auto 56px;line-height:1.6;font-weight:300}\n.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}\n.product-card{position:relative;border-radius:20px;background:linear-gradient(145deg,#111,#0d0d0d);border:1px solid rgba(255,255,255,.05);overflow:hidden;transition:all .4s;cursor:pointer}\n.product-card:hover{border-color:rgba(201,169,78,.2);transform:translateY(-6px);box-shadow:0 20px 50px rgba(0,0,0,.4)}\n.product-img{height:240px;background:linear-gradient(145deg,#151510,#0f0f0a);display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;overflow:hidden}\n.product-img::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 80%,rgba(139,105,20,.08),transparent 60%)}\n.product-info{padding:24px}\n.product-strain{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#C9A94E;margin-bottom:6px}\n.product-name{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;margin-bottom:8px}\n.product-desc{font-size:13px;color:rgba(245,240,235,.4);line-height:1.6;margin-bottom:16px}\n.product-meta{display:flex;align-items:center;justify-content:space-between}\n.product-thc{font-size:12px;font-weight:600;color:rgba(245,240,235,.6);letter-spacing:.5px}\n.product-price{font-size:18px;font-weight:700;color:#C9A94E}\n\n/* About / Story */\n.story{padding:100px 24px;position:relative}\n.story::before{content:'';position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(139,105,20,.06),transparent 70%);top:0;left:-200px;pointer-events:none}\n.story-content{max-width:680px;margin:0 auto;text-align:center}\n.story-quote{font-family:'Playfair Display',serif;font-size:clamp(22px,4vw,36px);font-weight:400;font-style:italic;line-height:1.5;letter-spacing:-.5px;margin:32px 0}\n.story-quote span{color:#C9A94E}\n.story-author{font-size:13px;color:rgba(245,240,235,.35);letter-spacing:1px;text-transform:uppercase;font-weight:500}\n\n/* Stats */\n.stats{display:flex;gap:48px;justify-content:center;padding:80px 24px;border-top:1px solid rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.04)}\n.stat{text-align:center}\n.stat-num{font-family:'Playfair Display',serif;font-size:clamp(32px,6vw,52px);font-weight:900;letter-spacing:-1px;background:linear-gradient(135deg,#8B6914,#C9A94E,#E8D48B);-webkit-background-clip:text;-webkit-text-fill-color:transparent}\n.stat-label{font-size:11px;color:rgba(245,240,235,.35);margin-top:6px;letter-spacing:1.5px;text-transform:uppercase;font-weight:500}\n\n/* Experience */\n.experience{padding:100px 24px;max-width:1000px;margin:0 auto}\n.exp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:28px}\n.exp-card{padding:32px;border-radius:16px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.04);transition:all .3s}\n.exp-card:hover{border-color:rgba(201,169,78,.15);background:rgba(201,169,78,.03)}\n.exp-icon{width:48px;height:48px;border-radius:12px;background:rgba(201,169,78,.08);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:20px}\n.exp-card h3{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;margin-bottom:10px}\n.exp-card p{font-size:13px;color:rgba(245,240,235,.4);line-height:1.7}\n\n/* CTA */\n.cta{text-align:center;padding:120px 24px;position:relative}\n.cta::before{content:'';position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(139,105,20,.08),transparent 65%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}\n.cta h2{font-family:'Playfair Display',serif;font-size:clamp(28px,6vw,52px);font-weight:900;letter-spacing:-1px;margin-bottom:20px;line-height:1.1}\n.cta p{font-size:15px;color:rgba(245,240,235,.4);max-width:420px;margin:0 auto 40px;line-height:1.7;font-weight:300}\n\n/* Age gate banner */\n.age-note{text-align:center;padding:12px;font-size:10px;color:rgba(245,240,235,.2);letter-spacing:1px;text-transform:uppercase;border-top:1px solid rgba(255,255,255,.04)}\n\n/* Footer */\nfooter{padding:48px 24px 24px;text-align:center}\n.footer-logo{font-family:'Playfair Display',serif;font-size:28px;font-weight:900;margin-bottom:16px}\n.footer-logo span{color:#C9A94E}\n.footer-links{display:flex;gap:24px;justify-content:center;font-size:12px;color:rgba(245,240,235,.3);margin-bottom:24px;flex-wrap:wrap}\n.footer-links a{color:inherit;text-decoration:none;transition:color .3s}\n.footer-links a:hover{color:#C9A94E}\n.footer-copy{font-size:11px;color:rgba(245,240,235,.15);letter-spacing:.5px}\n\n@media(max-width:600px){\n  .nav-links{display:none}\n  .stats{gap:20px;flex-wrap:wrap}\n  .hero{padding:100px 20px 60px}\n  .product-grid{grid-template-columns:1fr}\n}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"nav-logo\">10<span>/</span>10</div>\n  <div class=\"nav-links\">\n    <a href=\"#products\">Products</a>\n    <a href=\"#story\">Story</a>\n    <a href=\"#experience\">Experience</a>\n  </div>\n  <button class=\"nav-cta\">Shop Now</button>\n</nav>\n\n<section class=\"hero\">\n  <div class=\"hero-tag\"><span class=\"leaf\">&#x1F33F;</span> Premium Cannabis</div>\n  <h1>10<span class=\"brand-accent\">/</span>10</h1>\n  <p class=\"hero-sub\">Curated strains. Uncompromising quality. Every product is a perfect score — because you deserve nothing less.</p>\n  <div class=\"hero-buttons\">\n    <button class=\"btn-gold\">Explore Strains</button>\n    <button class=\"btn-outline\">Our Story</button>\n  </div>\n</section>\n\n<div class=\"gold-line\"></div>\n\n<section class=\"products\" id=\"products\">\n  <span class=\"section-tag\">The Collection</span>\n  <h2 class=\"section-title\">Featured Strains</h2>\n  <p class=\"section-sub\">Hand-selected, small-batch cultivars grown with precision and care.</p>\n  <div class=\"product-grid\">\n    <div class=\"product-card\">\n      <div class=\"product-img\">&#x1F33F;</div>\n      <div class=\"product-info\">\n        <div class=\"product-strain\">Sativa Dominant</div>\n        <div class=\"product-name\">Golden Hour</div>\n        <p class=\"product-desc\">Bright citrus notes with an uplifting, creative euphoria. Perfect for daytime inspiration.</p>\n        <div class=\"product-meta\">\n          <span class=\"product-thc\">THC 28% &#x2022; CBD 1%</span>\n          <span class=\"product-price\">$55</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"product-card\">\n      <div class=\"product-img\">&#x1F343;</div>\n      <div class=\"product-info\">\n        <div class=\"product-strain\">Indica</div>\n        <div class=\"product-name\">Midnight Velvet</div>\n        <p class=\"product-desc\">Deep berry undertones with a smooth, full-body relaxation. The ultimate wind-down.</p>\n        <div class=\"product-meta\">\n          <span class=\"product-thc\">THC 32% &#x2022; CBD 2%</span>\n          <span class=\"product-price\">$62</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"product-card\">\n      <div class=\"product-img\">&#x2728;</div>\n      <div class=\"product-info\">\n        <div class=\"product-strain\">Hybrid</div>\n        <div class=\"product-name\">Perfect Ten</div>\n        <p class=\"product-desc\">Our signature strain. Balanced euphoria meets calm clarity — a true 10/10 experience.</p>\n        <div class=\"product-meta\">\n          <span class=\"product-thc\">THC 30% &#x2022; CBD 3%</span>\n          <span class=\"product-price\">$68</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"story\" id=\"story\">\n  <div class=\"story-content\">\n    <div class=\"gold-line\"></div>\n    <p class=\"story-quote\">\"We don't settle for anything less than <span>perfect</span>. Every harvest, every cure, every product — held to the same standard. <span>10/10</span>, every time.\"</p>\n    <p class=\"story-author\">— The 10/10 Founders</p>\n  </div>\n</section>\n\n<div class=\"stats\">\n  <div class=\"stat\"><div class=\"stat-num\">10/10</div><div class=\"stat-label\">Quality Score</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">100%</div><div class=\"stat-label\">Organic</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">50+</div><div class=\"stat-label\">Strains</div></div>\n  <div class=\"stat\"><div class=\"stat-num\">24K+</div><div class=\"stat-label\">Happy Customers</div></div>\n</div>\n\n<section class=\"experience\" id=\"experience\">\n  <span class=\"section-tag\">The 10/10 Difference</span>\n  <h2 class=\"section-title\">Why Choose Us</h2>\n  <p class=\"section-sub\">From seed to sale, every step is intentional.</p>\n  <div class=\"exp-grid\">\n    <div class=\"exp-card\">\n      <div class=\"exp-icon\">&#x1F331;</div>\n      <h3>Craft Grown</h3>\n      <p>Small-batch cultivation with meticulous attention to genetics, soil, and environment. No shortcuts.</p>\n    </div>\n    <div class=\"exp-card\">\n      <div class=\"exp-icon\">&#x1F52C;</div>\n      <h3>Lab Tested</h3>\n      <p>Every batch independently tested for potency, purity, and terpene profile. Full transparency.</p>\n    </div>\n    <div class=\"exp-card\">\n      <div class=\"exp-icon\">&#x1F3AF;</div>\n      <h3>Curated Selection</h3>\n      <p>We only carry strains that meet our 10/10 standard. If it's not perfect, it doesn't make the cut.</p>\n    </div>\n    <div class=\"exp-card\">\n      <div class=\"exp-icon\">&#x1F30D;</div>\n      <h3>Sustainably Sourced</h3>\n      <p>Eco-conscious packaging, renewable energy operations, and a commitment to the planet.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta\">\n  <h2>Ready for a<br>perfect <span style=\"color:#C9A94E\">10</span>?</h2>\n  <p>Explore our collection and discover why thousands choose 10/10 as their go-to cannabis brand.</p>\n  <button class=\"btn-gold\">Shop the Collection</button>\n</section>\n\n<div class=\"age-note\">Must be 21+ to purchase. Please consume responsibly.</div>\n\n<footer>\n  <div class=\"footer-logo\">10<span>/</span>10</div>\n  <div class=\"footer-links\">\n    <a href=\"#\">Products</a>\n    <a href=\"#\">About</a>\n    <a href=\"#\">Locations</a>\n    <a href=\"#\">Contact</a>\n    <a href=\"#\">FAQ</a>\n  </div>\n  <p class=\"footer-copy\">&copy; 2026 10/10 Cannabis. All rights reserved. Licensed &amp; compliant.</p>\n</footer>\n\n</body>\n</html>\n"
